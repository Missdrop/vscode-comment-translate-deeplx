{
  "name": "deeplx-comment-translate",
  "displayName": "Deeplx Comment Translate",
  "description": "deeplx translate source for comment-translate",
  "version": "20.0.0",
  "publisher": "deeplx-comment-translate",
  "engines": {
    "vscode": "^1.63.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "deeplx",
    "翻译",
    "comment translate",
    "Deeplx",
    "Deeplx translate",
    "注释翻译"
  ],
  "homepage": "https://github.com/zj1016/vscode-comment-translate-deeplx#readme",
  "bugs": {
    "url": "https://github.com/zj1016/vscode-comment-translate-deeplx/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zj1016/vscode-comment-translate-deeplx.git"
  },
  "activationEvents": [],
  "main": "./out/extension.js",
  "icon": "image/logo.png",
  "extensionDependencies": [
    "intellsmi.comment-translate"
  ],
  "contributes": {
    "configuration": [
      {
        "title": "DeepLX translate API(DeepLX翻译API)",
        "type": "Object",
        "properties": {
          "deeplxTranslate.authKey": {
            "type": "string",
            "markdownDescription": "API endpoint URL. Default: http://127.0.0.1:1188/translate",
            "default": "http://127.0.0.1:1188/translate"
          },
          "deeplxTranslate.token": {
            "type": "string",
            "markdownDescription": "API access token for Authorization header (leave empty if no token required)",
            "default": ""
          },
          "deeplxTranslate.useUrlToken": {
            "type": "boolean",
            "markdownDescription": "If true, pass token as URL parameter (?token=...) instead of Authorization header",
            "default": false
          }
        }
      },
      {
        "title": "source lang(翻译语言)",
        "type": "Object",
        "properties": {
          "deeplxTranslate.source": {
            "type": "string",
            "markdownDescription": "default: EN",
            "enum": [
              "BG", "CS", "DA", "DE", "EL", "EN", "ES", "ET", "FI", "FR",
              "HU", "ID", "IT", "JA", "KO", "LT", "LV", "NB", "NL", "PL",
              "PT", "RO", "RU", "SK", "SL", "SV", "TR", "UK", "ZH"
            ],
            "default": "EN"
          }
        }
      },
      {
        "title": "target lang(目标语言)",
        "type": "Object",
        "properties": {
          "deeplxTranslate.target": {
            "type": "string",
            "markdownDescription": "default: ZH",
            "enum": [
              "BG", "CS", "DA", "DE", "EL", "EN", "ES", "ET", "FI", "FR",
              "HU", "ID", "IT", "JA", "KO", "LT", "LV", "NB", "NL", "PL",
              "PT", "RO", "RU", "SK", "SL", "SV", "TR", "UK", "ZH"
            ],
            "default": "ZH"
          }
        }
      }
    ],
    "translates": [
      {
        "translate": "deeplx",
        "title": "DeepLX translate"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/glob": "^7.1.4",
    "@types/mocha": "^9.0.0",
    "@types/node": "14.x",
    "@types/vscode": "^1.63.0",
    "@typescript-eslint/eslint-plugin": "^5.1.0",
    "@typescript-eslint/parser": "^5.1.0",
    "@vscode/test-electron": "^1.6.2",
    "eslint": "^8.1.0",
    "glob": "^7.1.7",
    "mocha": "^9.1.3",
    "typescript": "^4.4.4"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "comment-translate-manager": "^0.0.2",
    "querystring": "^0.2.1"
  }
}
